# Local credentials. API/.env is currently tracked upstream, so publish with
# selective staging and never stage its local modifications.
API/.env
.env
.env.*
!API/.env.example

# User data, generated media, and local archives
data/
# The image-generation seed is a bundled, immutable distribution asset rather
# than local user data. Keep this exception narrowly scoped to this one file.
!static/data/
static/data/*
!static/data/image-generation-presets.v1.json
# Official fixed-case media is local content distributed through backups, not
# part of the public GitHub program release. Keep an optional directory marker.
static/image-generation-examples/*
!static/image-generation-examples/.gitkeep
assets/
output/
outputs/
history.json
global_config.json
data.zip

# Bundled/local runtimes and caches
python/
__pycache__/
*.py[cod]
.playwright-cli/

# Local process files and logs
_self_restart.*
*.log
tests/fixtures/image-generation-presets-test.json

# Codex working-memory files
task_plan.md
findings.md
progress.md
